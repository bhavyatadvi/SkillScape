# Copy this file to backend/SkillScape/.env for local API development.
# Replace the JWT placeholder with a random secret of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=SkillScapeDb;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true
MongoDbSettings__ConnectionString=mongodb://localhost:27017
EmailSettings__Password=
AI_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_SKILL_ANALYZER_API_KEY=
GEMINI_API_KEY=
GROQ_API_RESUME=
GROQ_RESUME_MODEL=
